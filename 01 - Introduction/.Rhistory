#Shows how to assign values to variables in R and do basic mathematical calculations
z <- 3
y <- -2
x <- c(1,2,6)
w <- 1:4
v <- z*y
u <- z/y
t <- z+y
s <- z-y
r <- x*z
w <- 4.3
q <- x+w
p <- x*w
o <- x/w
n <- sqrt(w) #Note that sqrt(-1) produces the NaN error in R which stands for "Not a Number"
boxplot(Monthly.Starting.Salary.... ~ Major,
data = major_salaries_df,
xlab = "Business Major",
ylab = "Monthly Starting Salary ($)")
#Creates comparative boxplots for the Starting Salary data by majors
major_salaries_df <- read.csv("majorsalaries_r.csv")
