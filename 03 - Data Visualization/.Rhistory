aptitude_df <- read.csv("aptitude_test_r.csv")
aptitude_scores <- aptitude_df$Correct
stem(aptitude_scores)
audit_df <- read.csv("audit_r.csv")
audit_times <- audit_df$Audit.Time
hist(audit_times, main = "Histogram of Audit Times",
xlab = "Time (min)",
xlim = c(10,35),
col = "blue",
breaks = 5)
audit_df <- read.csv("audit_r.csv")
audit_times <- audit_df$Audit.Time
hist(audit_times, main = "Histogram of Audit Times",
xlab = "Time (min)",
xlim = c(10,35),
col = "pink",
breaks = 5)
softdrink_df <- read.csv("softdrink_r.csv")
table(softdrink_df)
barplot(table(softdrink_df))
regional_df <- read.csv("kirklandregional_r.csv")
regional_sales_df <- regional_df[ ,-1]
regional_sales_matrix <- as.matrix(regional_sales_df)
barplot(t(regional_sales_matrix),
xlab = "Month",
ylab = "Sales ($100s)",
names.arg = c("Jan", "Feb", "Mar", "Apr", "May", "Jun",
"Jul", "Aug", "Sep", "Oct", "Nov", "Dec"),
legend = c("North", "South"))
